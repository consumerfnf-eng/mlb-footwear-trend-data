{
  "brand": "MLB",
  "product_domain": "FOOTWEAR",
  "schema_version": "1.0",
  "updated_at": "2026-07-24",
  "active": true,
  "purpose": [
    "글로벌 신발 상품 이미지와 공식 설명을 동일한 기준으로 라벨링",
    "MLB 8개 카테고리와 서브카테고리 자동 분류",
    "PREMIUM SPORTIVE, STREET, FEMININE, WELLNESS 라이프스타일 DNA 분류",
    "Supabase 검색·필터·차트·추천 점수 계산",
    "MLB 디자인 제안 및 이미지 생성 프롬프트 구성",
    "사용자 확정값을 다음 분류의 기준 사례로 재사용"
  ],
  "dependencies": {
    "category_taxonomy": "MLB_Musinsa_8Line_Footwear_Taxonomy_v2_2.json",
    "category_taxonomy_version": "2.2",
    "lifestyle_dna": "MLB_Footwear_Lifestyle_DNA_Config_v1_1.json",
    "lifestyle_dna_version": "1.1"
  },
  "design_principles": {
    "category_basis": "카테고리는 컬러·프린트가 아니라 시즌성, 착화 포맷, 기본 원형, 어퍼 구조, 솔 구조와 기능으로 판정",
    "lifestyle_basis": "라이프스타일은 카테고리와 독립적으로 소재 감도, 비례, 디테일 표현, 기능, 사용 장면으로 판정",
    "controlled_vocabulary": "차트와 AI 학습에 사용하는 값은 통제 어휘를 사용하고 브랜드 원문은 raw 필드에 별도 보존",
    "max_upper_materials": 3,
    "max_representative_colors": 3,
    "user_override_priority": "사용자 확정값이 AI 판정값보다 항상 우선",
    "new_line_guard": "NEW LINE을 기타·미분류 상품을 버리는 항목으로 사용하지 않음"
  },
  "classification_engine": {
    "input_sequence": [
      "SOURCE_METADATA",
      "FORM_AND_STRUCTURE",
      "SOLE",
      "UPPER_MATERIAL",
      "DETAIL",
      "PRINT_PATTERN",
      "BRANDING",
      "COLOR",
      "FUNCTION",
      "CATEGORY",
      "LIFESTYLE",
      "REVIEW"
    ],
    "derived_flags": {
      "winter_dominance": "insulation=true OR fur_coverage IN [MAJOR,FULL] OR padded_upper_coverage IN [MAJOR,FULL] OR official_season_signal=WINTER",
      "open_format": "open_toe=true OR open_heel=true OR backless=true OR base_archetype IN [SANDAL,SLIDE,MULE,CLOG,FLIP_FLOP]",
      "outdoor_score": "COUNT_TRUE(aggressive_lug, waterproof, water_repellent, ripstop, protective_toe, webbing, quick_lace, gaiter, drainage, ankle_protection, trail_grip)",
      "new_line_gate": "mary_jane_dress=true OR formal_upper_sport_sole_hybrid=true OR modular_convertible=true OR verified_nonseason_hybrid=true",
      "sneaker_mary_jane": "base_archetype=MARY_JANE_SNEAKER AND sneaker_sole=true",
      "low_profile_gate": "sole_height_level<=2 AND upper_volume=SLIM AND toe_height=LOW AND foot_hugging=true AND base_archetype IN [TERRACE,RACING,DRIVING,MARTIAL_ARTS,BALLET,SLIM_RETRO_TRAINER]",
      "liner_archetype": "base_archetype IN [BASIC,COURT,TENNIS,DUNK,BASKET_HERITAGE,SKATE,CANVAS,VULCANIZED,CLASSIC_SLIP_ON]",
      "liner_precedence": "liner_archetype=true AND sole_continuity=true AND sole_sculpture_level<=2",
      "chunky_gate": "sole_height_level>=4 AND sole_sculpture_level>=3 AND sole_dominance=true",
      "runner_score": "COUNT_TRUE(mesh_upper, foam_midsole, heel_counter, heel_support, toe_spring, rocker, heel_to_toe_drop, segmented_outsole, running_last)",
      "material_mix": "COUNT_DISTINCT(upper_materials.material_type)>=2",
      "monogram": "pattern_motif=MONOGRAM",
      "review_required": "classification_confidence<0.80 OR top_two_score_gap<0.12 OR required_visual_evidence_missing=true"
    },
    "priority_rules": [
      {
        "order": 1,
        "result": "SOURCE_PRESERVED",
        "condition": "항상 적용",
        "rule": "브랜드 원문 카테고리, 상품유형, 상품명, 컬러명과 공식 설명을 수정하지 않고 보존"
      },
      {
        "order": 2,
        "result": "WINTER ITEM",
        "condition": "winter_dominance=true",
        "rule": "퍼 트림 하나가 아니라 퍼·쉐어링·패딩·보온 구조가 제품을 지배해야 함"
      },
      {
        "order": 3,
        "result": "SUMMER ITEM",
        "condition": "open_format=true",
        "rule": "샌들·슬리퍼·뮬·클로그·오픈 토·오픈 힐. 아웃도어 샌들과 스니커즈 뮬도 포함"
      },
      {
        "order": 4,
        "result": "OUTDOOR",
        "condition": "open_format=false AND outdoor_score>=2",
        "rule": "폐쇄형 신발에서 실제 아웃도어 구조·소재 신호가 2개 이상"
      },
      {
        "order": 5,
        "result": "NEW LINE",
        "condition": "new_line_gate=true",
        "rule": "일반 메리제인 구두, 스노퍼, 드레스 스니커, 모듈·비시즌 구조 하이브리드"
      },
      {
        "order": 6,
        "result": "SNEAKERS",
        "condition": "sneaker_mary_jane=true OR low_profile_gate=true",
        "rule": "스니커즈형 메리제인 또는 테라스·레이싱·무술·발레 등 발 밀착 저상 원형"
      },
      {
        "order": 7,
        "result": "LINER",
        "condition": "liner_precedence=true",
        "rule": "기본·코트·덩크·스케이트·캔버스 원형과 평평하고 연속적인 솔 구조 우선. 굽이 높아도 LINER"
      },
      {
        "order": 8,
        "result": "CHUNKY",
        "condition": "chunky_gate=true",
        "rule": "LV Tatic 기준. 높은 솔과 강한 요철·파동·분절이 전체 외곽선을 지배"
      },
      {
        "order": 9,
        "result": "RUNNER",
        "condition": "runner_score>=3",
        "rule": "러닝 구조 신호가 3개 이상이고 chunky_gate를 통과하지 않음"
      },
      {
        "order": 10,
        "result": "LINER",
        "condition": "liner_archetype=true",
        "rule": "남은 기본·코트·덩크·스케이트·캔버스 원형"
      },
      {
        "order": 11,
        "result": "REVIEW_REQUIRED",
        "condition": "어느 필수 게이트도 충족하지 않음",
        "rule": "NEW LINE으로 자동 전송하지 않고 사용자 검수 요청"
      }
    ],
    "category_subcategories": {
