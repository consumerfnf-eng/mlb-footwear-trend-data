      "material_mix_type": "boolean",
      "true_condition": "upper_materials에 서로 다른 material_type이 2개 이상",
      "role_coverage_guide": {
        "MAIN": "약 50% 이상 또는 제품 인상을 가장 강하게 결정",
        "SECONDARY": "약 20~49% 또는 주요 구조 패널",
